<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Theme.DoughlyCrumbl.AppBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/heightTopAppBar"
        android:background="@color/colorSurface"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/colorTextPrimary"
        app:title="@string/checkout_title"
        app:titleCentered="true"
        app:titleTextColor="@color/colorTextPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/marginPage">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOrderSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radiusCard"
                app:cardElevation="@dimen/elevationCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="0.5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/paddingCard">

                    <TextView
                        android:id="@+id/tvOrderSummaryLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/order_summary"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.TitleLarge"
                        app:layout_constraintBottom_toBottomOf="@id/btnToggleSummary"
                        app:layout_constraintEnd_toStartOf="@id/tvItemCount"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/btnToggleSummary" />

                    <TextView
                        android:id="@+id/tvItemCount"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/heightChip"
                        android:layout_marginEnd="@dimen/spacing_8"
                        android:background="@drawable/bg_chip_selected"
                        android:gravity="center"
                        android:paddingStart="@dimen/spacing_12"
                        android:paddingEnd="@dimen/spacing_12"
                        android:text="@string/item_count_format"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption"
                        android:textColor="@color/colorSurface"
                        app:layout_constraintBottom_toBottomOf="@id/btnToggleSummary"
                        app:layout_constraintEnd_toStartOf="@id/btnToggleSummary"
                        app:layout_constraintTop_toTopOf="@id/btnToggleSummary" />

                    <TextView
                        android:id="@+id/btnToggleSummary"
                        android:layout_width="@dimen/minTouchTarget"
                        android:layout_height="@dimen/minTouchTarget"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/show_summary"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                        android:textColor="@color/colorPrimary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvSummarySubtotalLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:text="@string/subtotal"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                        app:layout_constraintEnd_toStartOf="@id/tvSummarySubtotal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/btnToggleSummary" />

                    <TextView
                        android:id="@+id/tvSummarySubtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/price_zero"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                        android:textColor="@color/colorTextPrimary"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvSummarySubtotalLabel"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <LinearLayout
                        android:id="@+id/layoutExpandedItems"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:orientation="vertical"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvSummarySubtotalLabel" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvFulfillmentLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/checkout_fulfillment_question"
                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.TitleLarge"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardOrderSummary" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardDelivery"
                android:layout_width="0dp"
                android:layout_height="@dimen/heightFulfillmentOption"
                android:layout_marginTop="@dimen/spacing_8"
                android:layout_marginEnd="@dimen/spacing_4"
                android:background="@drawable/bg_fulfillment_selected"
                android:foreground="@drawable/ripple_card"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/spacing_12"
                app:layout_constraintEnd_toStartOf="@id/cardPickup"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvFulfillmentLabel"
                app:layout_constraintWidth_percent="0.5">

                <ImageView
                    android:id="@+id/tvDeliveryIcon"
                    android:layout_width="@dimen/iconSize"
                    android:layout_height="@dimen/iconSize"
                    android:contentDescription="@string/fulfillment_delivery"
                    android:src="@drawable/ic_truck"
                    app:tint="@color/colorPrimary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvDeliveryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:gravity="center"
                    android:text="@string/fulfillment_delivery"
                    android:textAppearance="@style/TextAppearance.DoughlyCrumbl.TitleMedium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDeliveryIcon" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:gravity="center"
                    android:text="@string/fulfillment_delivery_body"
                    android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDeliveryTitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardPickup"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/spacing_4"
                android:background="@drawable/bg_fulfillment_unselected"
                android:foreground="@drawable/ripple_card"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/spacing_12"
                app:layout_constraintBottom_toBottomOf="@id/cardDelivery"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cardDelivery"
                app:layout_constraintTop_toTopOf="@id/cardDelivery">

                <ImageView
                    android:id="@+id/tvPickupIcon"
                    android:layout_width="@dimen/iconSize"
                    android:layout_height="@dimen/iconSize"
                    android:contentDescription="@string/fulfillment_pickup"
                    android:src="@drawable/ic_store"
                    app:tint="@color/colorPrimary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvPickupTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:gravity="center"
                    android:text="@string/fulfillment_pickup"
                    android:textAppearance="@style/TextAppearance.DoughlyCrumbl.TitleMedium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvPickupIcon" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:gravity="center"
                    android:text="@string/fulfillment_pickup_body"
                    android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvPickupTitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilContactPhone"
                style="@style/Widget.DoughlyCrumbl.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:hint="@string/contact_number"
                app:boxBackgroundMode="none"
                app:errorEnabled="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardDelivery"
                app:startIconDrawable="@drawable/ic_phone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContactPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:inputType="phone" />

            </com.google.android.material.textfield.TextInputLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/sectionDeliveryDetails"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilContactPhone">

                <TextView
                    android:id="@+id/tvDeliveryAddressLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/delivery_address"
                    android:textAppearance="@style/TextAppearance.DoughlyCrumbl.TitleLarge"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilStreet"
                    style="@style/Widget.DoughlyCrumbl.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:hint="@string/street_barangay"
                    app:boxBackgroundMode="none"
                    app:errorEnabled="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDeliveryAddressLabel"
                    app:startIconDrawable="@drawable/ic_location">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStreet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:inputType="textPostalAddress" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCity"
                    style="@style/Widget.DoughlyCrumbl.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:hint="@string/city"
                    app:boxBackgroundMode="none"
                    app:errorEnabled="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tilStreet">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:inputType="textPostalAddress" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilLandmark"
                    style="@style/Widget.DoughlyCrumbl.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:hint="@string/landmark_optional"
                    app:boxBackgroundMode="none"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tilCity">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLandmark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:inputType="text" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvDeliveryFeeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:text="@string/estimated_delivery_fee"
                    android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvDeliveryFee"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tilLandmark" />

                <TextView
                    android:id="@+id/tvDeliveryFee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/delivery_fee_pending"
                    android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Price"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvDeliveryFeeLabel"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNotes"
                style="@style/Widget.DoughlyCrumbl.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:hint="@string/checkout_notes_hint"
                app:boxBackgroundMode="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/sectionDeliveryDetails">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNotes"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/heightInputMultiLine"
                    android:background="@drawable/bg_input"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:minLines="3" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvPaymentLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/payment_method"
                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.TitleLarge"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilNotes" />

            <include
                android:id="@+id/paymentGcash"
                layout="@layout/include_payment_gcash"
                android:layout_width="0dp"
                android:layout_height="@dimen/heightPaymentOption"
                android:layout_marginTop="@dimen/spacing_8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPaymentLabel" />

            <include
                android:id="@+id/paymentMaya"
                layout="@layout/include_payment_maya"
                android:layout_width="0dp"
                android:layout_height="@dimen/heightPaymentOption"
                android:layout_marginTop="@dimen/spacing_8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/paymentGcash" />

            <include
                android:id="@+id/paymentBank"
                layout="@layout/include_payment_bank"
                android:layout_width="0dp"
                android:layout_height="@dimen/heightPaymentOption"
                android:layout_marginTop="@dimen/spacing_8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/paymentMaya" />

            <include
                android:id="@+id/paymentCash"
                layout="@layout/include_payment_cash"
                android:layout_width="0dp"
                android:layout_height="@dimen/heightPaymentOption"
                android:layout_marginTop="@dimen/spacing_8"
                android:layout_marginBottom="@dimen/spacing_16"
                android:alpha="0.45"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/paymentBank" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        android:elevation="@dimen/elevationBottomNav"
        android:padding="@dimen/marginPage"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_8"
            android:gravity="end"
            android:text="@string/price_zero"
            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Price"
            android:textColor="@color/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlaceOrder"
            style="@style/Style.DoughlyCrumbl.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/heightButtonPrimary"
            android:text="@string/place_order"
            android:textAllCaps="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTotal" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
