<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Hero banner (180dp) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/heroBanner"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_gradient_crimson"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvHeroSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/marginPage"
            android:fontFamily="@font/poppins"
            android:text="Welcome to Doughly Crumbl"
            android:textColor="@color/colorSurface"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@id/tvHeroTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0.38" />

        <TextView
            android:id="@+id/tvHeroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="@dimen/marginPage"
            android:fontFamily="@font/poppins"
            android:text="Freshly Baked Happiness"
            android:textColor="@color/colorSurface"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/btnExploreMenu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHeroSub" />

        <!-- "Explore Menu" pill at bottom-left -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExploreMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/marginPage"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/poppins"
            android:text="Explore Menu"
            android:textColor="@color/colorSurface"
            android:textSize="12sp"
            android:textAllCaps="false"
            app:backgroundTint="@color/colorHeroOverlay"
            app:cornerRadius="@dimen/radiusPill"
            app:strokeColor="@color/colorSurface"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Search bar wrapped in card for 12dp radius + shadow -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchCard"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/marginPage"
        android:layout_marginEnd="@dimen/marginPage"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="@dimen/radiusCard"
        app:cardElevation="@dimen/elevationCard"
        app:layout_constraintTop_toBottomOf="@id/heroBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorSurface"
            app:queryHint="Search pastries, cookies, breads..." />

    </com.google.android.material.card.MaterialCardView>

    <!-- Category filter chips (horizontal scroll) -->
    <HorizontalScrollView
        android:id="@+id/categoryScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/searchCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/marginPage"
            android:layout_marginEnd="@dimen/marginPage"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/heightChip"
                android:fontFamily="@font/poppins"
                android:text="All"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCookies"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/heightChip"
                android:fontFamily="@font/poppins"
                android:text="Cookies" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCroissants"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/heightChip"
                android:fontFamily="@font/poppins"
                android:text="Croissants" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDonuts"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/heightChip"
                android:fontFamily="@font/poppins"
                android:text="Donuts" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSourdough"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/heightChip"
                android:fontFamily="@font/poppins"
                android:text="Sourdough" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCakes"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/heightChip"
                android:fontFamily="@font/poppins"
                android:text="Cakes" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPastries"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/heightChip"
                android:fontFamily="@font/poppins"
                android:text="Pastries" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBeverages"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/heightChip"
                android:fontFamily="@font/poppins"
                android:text="Beverages" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <!-- Section header -->
    <LinearLayout
        android:id="@+id/sectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/marginPage"
        android:layout_marginEnd="@dimen/marginPage"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/categoryScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins"
            android:text="Featured Delights"
            android:textColor="@color/colorTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:minHeight="@dimen/minTouchTarget"
            android:gravity="center_vertical"
            android:padding="4dp"
            android:text="See all"
            android:textColor="@color/colorPrimary"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Content area: skeleton / product grid / empty state -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/sectionHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Skeleton RecyclerView (loading state) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/skeletonRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:padding="8dp"
                android:visibility="gone" />

            <!-- Live product grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:padding="8dp" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="No products found"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:text="Try a different search or category"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearFilters"
                    style="@style/Widget.DoughlyCrumbl.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Clear filters"
                    android:textAllCaps="false" />

            </LinearLayout>

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
