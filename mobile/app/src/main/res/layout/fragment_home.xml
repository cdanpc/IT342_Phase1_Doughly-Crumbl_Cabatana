<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Header -->


    <!-- Search row: EditText card + filter button -->
    <LinearLayout
        android:id="@+id/searchRow"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/marginPage"
        android:layout_marginEnd="@dimen/marginPage"
        android:layout_marginTop="@dimen/spacing_16"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/searchCard"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_8"
            app:cardCornerRadius="@dimen/radiusCard"
            app:cardElevation="@dimen/elevationCard"
            app:cardBackgroundColor="@color/colorSurface"
            app:strokeColor="@color/colorBorder"
            app:strokeWidth="0.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_12"
                android:paddingEnd="@dimen/spacing_12">

                <ImageView
                    android:layout_width="@dimen/iconSizeSmall"
                    android:layout_height="@dimen/iconSizeSmall"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@null"
                    app:tint="@color/colorTextMuted" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/filterCard"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/filter"
            app:cardCornerRadius="@dimen/radiusCard"
            app:cardElevation="@dimen/elevationCard"
            app:cardBackgroundColor="@color/colorSurface"
            app:strokeColor="@color/colorBorder"
            app:strokeWidth="0.5dp">

            <ImageView
                android:id="@+id/ibFilter"
                android:layout_width="@dimen/iconSize"
                android:layout_height="@dimen/iconSize"
                android:layout_gravity="center"
                android:src="@drawable/ic_filter"
                android:contentDescription="@string/filter"
                app:tint="@color/colorTextPrimary" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Promo banner -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/heroBanner"
        android:layout_width="0dp"
        android:layout_height="@dimen/heightHomePromo"
        android:layout_marginStart="@dimen/marginPage"
        android:layout_marginTop="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/marginPage"
        android:background="@drawable/bg_gradient_crimson"
        android:padding="@dimen/spacing_16"
        app:layout_constraintTop_toBottomOf="@id/searchRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/promoLabelCard"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/heightChip"
            app:cardBackgroundColor="@color/colorGold"
            app:cardCornerRadius="@dimen/radiusPill"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="@dimen/spacing_16"
                android:paddingEnd="@dimen/spacing_16"
                android:text="@string/home_promo_label"
                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption"
                android:textColor="@color/colorPrimaryDark"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvHeroTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/home_promo_title"
            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.DisplayLarge"
            android:textColor="@color/colorSurface"
            app:layout_constraintEnd_toStartOf="@id/ivPromoLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/promoLabelCard" />

        <TextView
            android:id="@+id/tvHeroSub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:text="@string/home_promo_subtitle"
            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyLarge"
            android:textColor="@color/colorSurface"
            app:layout_constraintEnd_toStartOf="@id/ivPromoLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHeroTitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExploreMenu"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/heightButtonSecondary"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/home_promo_action"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimaryDark"
            app:backgroundTint="@color/colorGold"
            app:cornerRadius="@dimen/radiusPill"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHeroSub" />

        <ImageView
            android:id="@+id/ivPromoLogo"
            android:layout_width="@dimen/promoLogoSize"
            android:layout_height="@dimen/promoLogoSize"
            android:alpha="0.9"
            android:contentDescription="@string/logo_content_description"
            android:src="@drawable/logo_doughly_white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/categoryHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/marginPage"
        android:layout_marginTop="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/marginPage"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/heroBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_categories"
            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.HeadlineLarge" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/minTouchTarget"
            android:gravity="center"
            android:text="@string/home_see_all"
            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
            android:textColor="@color/colorPrimary" />

    </LinearLayout>

    <!-- Category filter chips (horizontal scroll) -->
    <HorizontalScrollView
        android:id="@+id/categoryScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/categoryHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/marginPage"
            android:layout_marginEnd="@dimen/marginPage"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Style.DoughlyCrumbl.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/heightChip"
                android:text="@string/home_category_all"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCookies"
                style="@style/Style.DoughlyCrumbl.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/heightChip"
                android:text="@string/home_category_cookies" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCroissants"
                style="@style/Style.DoughlyCrumbl.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/heightChip"
                android:text="@string/home_category_croissants" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDonuts"
                style="@style/Style.DoughlyCrumbl.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/heightChip"
                android:text="@string/home_category_donuts" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSourdough"
                style="@style/Style.DoughlyCrumbl.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/heightChip"
                android:text="@string/home_category_sourdough" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCakes"
                style="@style/Style.DoughlyCrumbl.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/heightChip"
                android:text="@string/home_category_cakes" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPastries"
                style="@style/Style.DoughlyCrumbl.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/heightChip"
                android:text="@string/home_category_pastries" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBeverages"
                style="@style/Style.DoughlyCrumbl.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/heightChip"
                android:text="@string/home_category_beverages" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <!-- Section header -->
    <LinearLayout
        android:id="@+id/sectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/marginPage"
        android:layout_marginEnd="@dimen/marginPage"
        android:layout_marginTop="@dimen/spacing_16"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/categoryScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_popular_bakes"
            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.HeadlineLarge" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/minTouchTarget"
            android:gravity="center_vertical"
            android:padding="@dimen/spacing_4"
            android:text="@string/home_see_all"
            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
            android:textColor="@color/colorPrimary" />

    </LinearLayout>

    <!-- Content: skeleton / product list / empty state -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_8"
        app:layout_constraintTop_toBottomOf="@id/sectionHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Skeleton RecyclerView (loading state) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/skeletonRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="@dimen/spacing_4"
                android:paddingBottom="@dimen/spacing_8"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <!-- Live product list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="@dimen/spacing_4"
                android:paddingBottom="@dimen/spacing_8"
                android:nestedScrollingEnabled="false" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_24"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_products"
                    android:textAppearance="@style/TextAppearance.DoughlyCrumbl.TitleMedium" />

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:gravity="center"
                    android:text="@string/home_empty_hint"
                    android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearFilters"
                    style="@style/Style.DoughlyCrumbl.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:text="@string/home_clear_filters"
                    android:textAllCaps="false" />

            </LinearLayout>

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
