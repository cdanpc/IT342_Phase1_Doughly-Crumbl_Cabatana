<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Theme.DoughlyCrumbl.AppBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/heightTopAppBar"
        android:background="@color/colorSurface"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/colorTextPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextColor="@color/colorTextPrimary" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/marginPage">

            <!-- Status Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/gapCard"
                app:cardCornerRadius="@dimen/radiusCard"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_24">

                    <TextView
                        android:id="@+id/tvStatusLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorSurface"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.HeadlineMedium" />

                    <TextView
                        android:id="@+id/tvStatusDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption"
                        android:textColor="@color/colorSurface" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Order Timeline -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/gapCard"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radiusCard"
                app:cardElevation="@dimen/elevationCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_12"
                        android:text="@string/order_status"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                        android:textColor="@color/colorTextPrimary" />

                    <!-- Step 1: Order Placed -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="@dimen/timelineRailWidth"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <View
                                android:id="@+id/dot1"
                                android:layout_width="@dimen/timelineDotSize"
                                android:layout_height="@dimen/timelineDotSize"
                                android:layout_gravity="center_horizontal"
                                android:background="@drawable/bg_timeline_dot_pending" />

                            <View
                                android:id="@+id/line1"
                                android:layout_width="@dimen/timelineLineWidth"
                                android:layout_height="@dimen/timelineLineHeight"
                                android:layout_gravity="center_horizontal"
                                android:background="@color/colorBorder" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_12"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingBottom="@dimen/spacing_8">

                            <TextView
                                android:id="@+id/tvStep1Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/order_placed"
                                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                                android:textColor="@color/colorTextPrimary" />

                            <TextView
                                android:id="@+id/tvTime1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pending"
                                android:textColor="@color/colorTextMuted"
                                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Step 2: Payment Confirmed -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="@dimen/timelineRailWidth"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <View
                                android:id="@+id/dot2"
                                android:layout_width="@dimen/timelineDotSize"
                                android:layout_height="@dimen/timelineDotSize"
                                android:layout_gravity="center_horizontal"
                                android:background="@drawable/bg_timeline_dot_pending" />

                            <View
                                android:id="@+id/line2"
                                android:layout_width="@dimen/timelineLineWidth"
                                android:layout_height="@dimen/timelineLineHeight"
                                android:layout_gravity="center_horizontal"
                                android:background="@color/colorBorder" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_12"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingBottom="@dimen/spacing_8">

                            <TextView
                                android:id="@+id/tvStep2Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/payment_confirmed"
                                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                                android:textColor="@color/colorTextPrimary" />

                            <TextView
                                android:id="@+id/tvTime2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pending"
                                android:textColor="@color/colorTextMuted"
                                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Step 3: Preparing -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="@dimen/timelineRailWidth"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <View
                                android:id="@+id/dot3"
                                android:layout_width="@dimen/timelineDotSize"
                                android:layout_height="@dimen/timelineDotSize"
                                android:layout_gravity="center_horizontal"
                                android:background="@drawable/bg_timeline_dot_pending" />

                            <View
                                android:id="@+id/line3"
                                android:layout_width="@dimen/timelineLineWidth"
                                android:layout_height="@dimen/timelineLineHeight"
                                android:layout_gravity="center_horizontal"
                                android:background="@color/colorBorder" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_12"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingBottom="@dimen/spacing_8">

                            <TextView
                                android:id="@+id/tvStep3Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/preparing"
                                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                                android:textColor="@color/colorTextPrimary" />

                            <TextView
                                android:id="@+id/tvTime3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pending"
                                android:textColor="@color/colorTextMuted"
                                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Step 4: Ready / Out for Delivery -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="@dimen/timelineRailWidth"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <View
                                android:id="@+id/dot4"
                                android:layout_width="@dimen/timelineDotSize"
                                android:layout_height="@dimen/timelineDotSize"
                                android:layout_gravity="center_horizontal"
                                android:background="@drawable/bg_timeline_dot_pending" />

                            <View
                                android:id="@+id/line4"
                                android:layout_width="@dimen/timelineLineWidth"
                                android:layout_height="@dimen/timelineLineHeight"
                                android:layout_gravity="center_horizontal"
                                android:background="@color/colorBorder" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_12"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingBottom="@dimen/spacing_8">

                            <TextView
                                android:id="@+id/tvStep4Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/out_for_delivery"
                                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                                android:textColor="@color/colorTextPrimary" />

                            <TextView
                                android:id="@+id/tvTime4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pending"
                                android:textColor="@color/colorTextMuted"
                                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Step 5 -->
                    <LinearLayout
                        android:id="@+id/rowStep5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="@dimen/timelineRailWidth"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <View
                                android:id="@+id/dot5"
                                android:layout_width="@dimen/timelineDotSize"
                                android:layout_height="@dimen/timelineDotSize"
                                android:layout_gravity="center_horizontal"
                                android:background="@drawable/bg_timeline_dot_pending" />

                            <View
                                android:id="@+id/line5"
                                android:layout_width="@dimen/timelineLineWidth"
                                android:layout_height="@dimen/timelineLineHeight"
                                android:layout_gravity="center_horizontal"
                                android:background="@color/colorBorder" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStep5Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/completed"
                                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                                android:textColor="@color/colorTextPrimary" />

                            <TextView
                                android:id="@+id/tvTime5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pending"
                                android:textColor="@color/colorTextMuted"
                                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Step 6 -->
                    <LinearLayout
                        android:id="@+id/rowStep6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="@dimen/timelineRailWidth"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <View
                                android:id="@+id/dot6"
                                android:layout_width="@dimen/timelineDotSize"
                                android:layout_height="@dimen/timelineDotSize"
                                android:layout_gravity="center_horizontal"
                                android:background="@drawable/bg_timeline_dot_pending" />

                            <View
                                android:id="@+id/line6"
                                android:layout_width="@dimen/timelineLineWidth"
                                android:layout_height="@dimen/timelineLineHeight"
                                android:layout_gravity="center_horizontal"
                                android:background="@color/colorBorder" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_12"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingBottom="@dimen/spacing_8">

                            <TextView
                                android:id="@+id/tvStep6Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                                android:textColor="@color/colorTextPrimary" />

                            <TextView
                                android:id="@+id/tvTime6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pending"
                                android:textColor="@color/colorTextMuted"
                                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Step 7 -->
                    <LinearLayout
                        android:id="@+id/rowStep7"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="@dimen/timelineRailWidth"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <View
                                android:id="@+id/dot7"
                                android:layout_width="@dimen/timelineDotSize"
                                android:layout_height="@dimen/timelineDotSize"
                                android:layout_gravity="center_horizontal"
                                android:background="@drawable/bg_timeline_dot_pending" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStep7Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                                android:textColor="@color/colorTextPrimary" />

                            <TextView
                                android:id="@+id/tvTime7"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pending"
                                android:textColor="@color/colorTextMuted"
                                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption" />

                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Order Items Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/gapCard"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radiusCard"
                app:cardElevation="@dimen/elevationCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_8"
                        android:text="@string/order_items"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                        android:textColor="@color/colorTextPrimary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="@dimen/spacing_8"
                        android:background="@color/colorBorder" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/spacing_8"
                        android:background="@color/colorBorder" />

                    <TextView
                        android:id="@+id/tvSubtotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                        android:textColor="@color/colorTextSecondary" />

                    <TextView
                        android:id="@+id/tvDeliveryFee"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                        android:textColor="@color/colorTextSecondary"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvGrandTotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                        android:textColor="@color/colorPrimary"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Delivery Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDelivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/gapCard"
                android:visibility="gone"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radiusCard"
                app:cardElevation="@dimen/elevationCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_8"
                        android:text="@string/delivery_details"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                        android:textColor="@color/colorTextPrimary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="@dimen/spacing_8"
                        android:background="@color/colorBorder" />

                    <TextView
                        android:id="@+id/tvDeliveryAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                        android:textColor="@color/colorTextPrimary" />

                    <TextView
                        android:id="@+id/tvContactNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                        android:textColor="@color/colorTextSecondary" />

                    <TextView
                        android:id="@+id/tvDeliveryNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                        android:textColor="@color/colorTextSecondary"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cancellation Reason Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCancellation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/gapCard"
                android:visibility="gone"
                app:cardBackgroundColor="@color/colorErrorBg"
                app:cardCornerRadius="@dimen/radiusCard"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorError"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/order_cancelled"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                        android:textColor="@color/colorError" />

                    <TextView
                        android:id="@+id/tvCancellationReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                        android:textColor="@color/colorTextSecondary" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Payment Proof Action Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPaymentAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/gapCard"
                android:visibility="gone"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radiusCard"
                app:cardElevation="@dimen/elevationCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_proof"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                        android:textColor="@color/colorTextPrimary" />

                    <TextView
                        android:id="@+id/tvProofStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                        android:textColor="@color/colorTextSecondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUploadProof"
                        style="@style/Style.DoughlyCrumbl.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:text="@string/upload_payment_proof"
                        android:textAllCaps="false" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Rate Order Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/gapCard"
                android:visibility="gone"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radiusCard"
                app:cardElevation="@dimen/elevationCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="@dimen/strokeWidthCardThin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:id="@+id/tvRatingTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_8"
                        android:text="@string/rate_order"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                        android:textColor="@color/colorTextPrimary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/spacing_12">

                        <ImageView
                            android:id="@+id/star1"
                            android:layout_width="@dimen/minTouchTarget"
                            android:layout_height="@dimen/minTouchTarget"
                            android:padding="@dimen/spacing_8"
                            android:src="@drawable/ic_star_outline"
                            android:contentDescription="@string/star_1" />

                        <ImageView
                            android:id="@+id/star2"
                            android:layout_width="@dimen/minTouchTarget"
                            android:layout_height="@dimen/minTouchTarget"
                            android:padding="@dimen/spacing_8"
                            android:src="@drawable/ic_star_outline"
                            android:contentDescription="@string/star_2" />

                        <ImageView
                            android:id="@+id/star3"
                            android:layout_width="@dimen/minTouchTarget"
                            android:layout_height="@dimen/minTouchTarget"
                            android:padding="@dimen/spacing_8"
                            android:src="@drawable/ic_star_outline"
                            android:contentDescription="@string/star_3" />

                        <ImageView
                            android:id="@+id/star4"
                            android:layout_width="@dimen/minTouchTarget"
                            android:layout_height="@dimen/minTouchTarget"
                            android:padding="@dimen/spacing_8"
                            android:src="@drawable/ic_star_outline"
                            android:contentDescription="@string/star_4" />

                        <ImageView
                            android:id="@+id/star5"
                            android:layout_width="@dimen/minTouchTarget"
                            android:layout_height="@dimen/minTouchTarget"
                            android:padding="@dimen/spacing_8"
                            android:src="@drawable/ic_star_outline"
                            android:contentDescription="@string/star_5" />

                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/rating_comment_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etComment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:maxLines="3" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubmitRating"
                        style="@style/Style.DoughlyCrumbl.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:text="@string/submit_rating"
                        android:textAllCaps="false" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cancel Order Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Style.DoughlyCrumbl.Button.Destructive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_8"
                android:text="@string/cancel_order"
                android:textAllCaps="false"
                android:visibility="gone" />

            <!-- Reorder Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReorder"
                style="@style/Style.DoughlyCrumbl.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_8"
                android:text="@string/order_again"
                android:textAllCaps="false"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
