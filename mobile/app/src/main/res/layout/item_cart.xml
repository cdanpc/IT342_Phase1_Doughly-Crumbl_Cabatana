<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/marginPage"
    android:layout_marginEnd="@dimen/marginPage"
    android:layout_marginBottom="@dimen/spacing_12"
    android:foreground="@drawable/ripple_card"
    app:cardBackgroundColor="@color/colorSurface"
    app:cardCornerRadius="@dimen/radiusCard"
    app:cardElevation="@dimen/elevationCard"
    app:strokeColor="@color/colorBorder"
    app:strokeWidth="0.5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/heightCartItemMin"
        android:padding="@dimen/spacing_12">

        <ImageView
            android:id="@+id/ivProduct"
            android:layout_width="@dimen/cartThumbSize"
            android:layout_height="@dimen/cartThumbSize"
            android:background="@drawable/bg_image_rounded"
            android:clipToOutline="true"
            android:contentDescription="@string/product_image_desc"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.HeadlineMedium"
            app:layout_constraintEnd_toStartOf="@id/btnRemove"
            app:layout_constraintStart_toEndOf="@id/ivProduct"
            app:layout_constraintTop_toTopOf="@id/ivProduct" />

        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_marginTop="@dimen/spacing_4"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivProduct"
            app:layout_constraintTop_toBottomOf="@id/tvName" />

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_marginTop="@dimen/spacing_8"
            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Price"
            app:layout_constraintEnd_toStartOf="@id/stepperGroup"
            app:layout_constraintStart_toEndOf="@id/ivProduct"
            app:layout_constraintTop_toBottomOf="@id/tvCategory" />

        <ImageButton
            android:id="@+id/btnRemove"
            android:layout_width="@dimen/minTouchTarget"
            android:layout_height="@dimen/minTouchTarget"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/remove_cart_item"
            android:src="@drawable/ic_trash"
            android:tint="@color/colorTextMuted"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivProduct" />

        <LinearLayout
            android:id="@+id/stepperGroup"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/minTouchTarget"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_4"
            android:paddingEnd="@dimen/spacing_4"
            app:layout_constraintBottom_toBottomOf="@id/ivProduct"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMinus"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="@dimen/minTouchTarget"
                android:layout_height="@dimen/minTouchTarget"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="@dimen/minTouchTarget"
                android:padding="0dp"
                android:text="@string/stepper_decrement"
                android:contentDescription="@string/decrease_quantity"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/textHeadlineMedium"
                app:cornerRadius="@dimen/radiusPill" />

            <TextView
                android:id="@+id/tvQty"
                android:layout_width="@dimen/minTouchTarget"
                android:layout_height="@dimen/minTouchTarget"
                android:gravity="center"
                android:text="1"
                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.TitleMedium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlus"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="@dimen/minTouchTarget"
                android:layout_height="@dimen/minTouchTarget"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="@dimen/minTouchTarget"
                android:padding="0dp"
                android:text="@string/stepper_increment"
                android:contentDescription="@string/increase_quantity"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/textHeadlineMedium"
                app:cornerRadius="@dimen/radiusPill" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
