<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/marginPage"
        android:paddingVertical="@dimen/spacing_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/notifications"
            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.DisplayLarge"
            android:textColor="@color/colorPrimary" />

        <TextView
            android:id="@+id/btnMarkAllRead"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/minTouchTarget"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/notifications_mark_all_read"
            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
            android:textColor="@color/colorPrimary" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="@dimen/marginPage"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerRow" />

    <LinearLayout
        android:id="@+id/errorState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_24"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerRow">

        <TextView
            android:id="@+id/tvNotificationsError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
            android:textColor="@color/colorTextSecondary" />

        <Button
            android:id="@+id/btnNotificationsRetry"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/minTouchTarget"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/retry"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_24"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerRow">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/heightNotificationIcon"
            android:layout_height="@dimen/heightNotificationIcon"
            app:cardBackgroundColor="@color/colorPrimaryLight"
            app:cardCornerRadius="@dimen/radiusAvatar"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="@dimen/iconSizeLarge"
                android:layout_height="@dimen/iconSizeLarge"
                android:layout_gravity="center"
                android:contentDescription="@string/notifications_caught_up"
                android:src="@drawable/ic_bell"
                app:tint="@color/colorPrimary" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="@string/notifications_caught_up"
            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.TitleMedium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:gravity="center"
            android:text="@string/notifications_empty_body"
            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
            android:textColor="@color/colorTextSecondary" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerRow" />

</androidx.constraintlayout.widget.ConstraintLayout>
