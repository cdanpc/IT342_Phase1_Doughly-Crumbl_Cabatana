<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/marginPage"
    android:layout_marginEnd="@dimen/marginPage"
    android:layout_marginBottom="@dimen/spacing_12"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/ripple_card"
    app:cardBackgroundColor="@color/colorSurface"
    app:cardCornerRadius="@dimen/radiusCard"
    app:cardElevation="@dimen/elevationCard"
    app:strokeColor="@color/colorBorder"
    app:strokeWidth="@dimen/strokeWidthCardThin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <!-- Row 1: Order ID + status chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.TitleMedium"
                android:textColor="@color/colorPrimary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/colorSurface"
                android:textSize="@dimen/textCaption"
                app:chipMinHeight="@dimen/heightChipSmall" />
        </LinearLayout>

        <!-- Row 2: Date -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium" />

        <TextView
            android:id="@+id/tvStatusFull"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:textSize="@dimen/textCaption"
            android:textColor="@color/colorTextMuted"
            android:visibility="gone" />

        <!-- Row 3: Contact + payment status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvContact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="@dimen/spacing_4"
                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                android:textColor="@color/colorTextSecondary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPayment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:textSize="@dimen/textSmall"
                app:chipMinHeight="@dimen/heightChipTiny" />
        </LinearLayout>

        <!-- Row 4: Total -->
        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:gravity="end"
            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Price" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
