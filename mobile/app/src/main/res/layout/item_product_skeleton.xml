<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/marginPage"
    android:layout_marginEnd="@dimen/marginPage"
    android:layout_marginBottom="@dimen/spacing_8"
    app:cardCornerRadius="@dimen/radiusCard"
    app:cardElevation="@dimen/elevationCard"
    app:cardBackgroundColor="@color/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_12"
        android:gravity="center_vertical">

        <!-- Image placeholder -->
        <View
            android:layout_width="@dimen/avatarLarge"
            android:layout_height="@dimen/avatarLarge"
            android:background="@drawable/bg_skeleton_rect" />

        <!-- Text placeholders -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_12"
            android:orientation="vertical">

            <View
                android:layout_width="140dp"
                android:layout_height="14dp"
                android:layout_marginBottom="@dimen/spacing_8"
                android:background="@drawable/bg_skeleton_rect" />

            <View
                android:layout_width="80dp"
                android:layout_height="11dp"
                android:layout_marginBottom="@dimen/spacing_12"
                android:background="@drawable/bg_skeleton_rect" />

            <View
                android:layout_width="64dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_skeleton_rect" />

        </LinearLayout>

        <!-- Add button placeholder -->
        <View
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_skeleton_rect" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
