<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_crimson">

    <!-- ── HEADER GUIDELINE ── -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="@dimen/heightAuthHeaderGuide" />

    <!-- ── LOGO ── -->
    <FrameLayout
        android:id="@+id/logoContainer"
        android:layout_width="@dimen/sizeLogo"
        android:layout_height="@dimen/heightLogoContainer"
        android:elevation="@dimen/elevationFab"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvWelcome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.45">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="@dimen/sizeLogo"
            android:layout_height="@dimen/sizeLogo"
            android:layout_gravity="center"
            android:contentDescription="@string/logo_content_description"
            android:elevation="@dimen/elevationCard"
            android:padding="@dimen/spacing_8"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_doughly_white" />

    </FrameLayout>

    <!-- Welcome title -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:fontFamily="@font/poppins"
        android:letterSpacing="0.01"
        android:text="@string/login_welcome_title"
        android:textColor="@color/colorSurface"
        android:textSize="@dimen/textDisplaySmall"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tvSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoContainer" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:alpha="0.85"
        android:fontFamily="@font/poppins"
        android:text="@string/login_welcome_subtitle"
        android:textColor="@color/colorPrimaryLight"
        android:textSize="@dimen/textBodyMedium"
        app:layout_constraintBottom_toTopOf="@id/guidelineHeader"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWelcome" />

    <!-- ── WHITE CARD (NestedScrollView for keyboard safety) ── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_card_top_rounded"
        android:elevation="12dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/marginPage"
            android:paddingTop="@dimen/spacing_32"
            android:paddingEnd="@dimen/marginPage"
            android:paddingBottom="@dimen/spacing_32">

            <!-- Section label -->
            <TextView
                android:id="@+id/tvSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_24"
                android:text="@string/login_section_label"
                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.HeadlineMedium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- ── EMAIL ── -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Widget.DoughlyCrumbl.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:background="@drawable/bg_input"
                app:boxBackgroundMode="none"
                app:errorEnabled="false"
                app:hintEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSectionLabel"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="@color/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/heightInput"
                    android:background="@null"
                    android:fontFamily="@font/poppins"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_email_address"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:textSize="@dimen/textBodyLarge" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email error label -->
            <TextView
                android:id="@+id/tvEmailError"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/spacing_4"
                android:paddingTop="@dimen/spacing_4"
                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption"
                android:textColor="@color/colorError"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilEmail" />

            <!-- ── PASSWORD ── -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.DoughlyCrumbl.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:background="@drawable/bg_input"
                app:boxBackgroundMode="none"
                app:endIconMode="password_toggle"
                app:errorEnabled="false"
                app:hintEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvEmailError"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="@color/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/heightInput"
                    android:background="@null"
                    android:fontFamily="@font/poppins"
                    android:gravity="center_vertical"
                    android:hint="@string/login_hint_password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textSize="@dimen/textBodyLarge" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password error label -->
            <TextView
                android:id="@+id/tvPasswordError"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/spacing_4"
                android:paddingTop="@dimen/spacing_4"
                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption"
                android:textColor="@color/colorError"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilPassword" />

            <!-- Forgot password -->
            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:minHeight="@dimen/minTouchTarget"
                android:paddingStart="@dimen/spacing_4"
                android:paddingEnd="@dimen/spacing_4"
                android:text="@string/login_forgot_password"
                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                android:textColor="@color/colorPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPasswordError" />

            <!-- ── ERROR BANNER ── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/errorBanner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:visibility="gone"
                app:cardBackgroundColor="@color/colorErrorBg"
                app:cardCornerRadius="@dimen/radiusCard"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvForgotPassword"
                app:strokeColor="@color/colorError"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_12"
                    android:paddingTop="@dimen/spacing_12"
                    android:paddingEnd="@dimen/spacing_12"
                    android:paddingBottom="@dimen/spacing_12">

                    <ImageView
                        android:layout_width="@dimen/iconSizeSmall"
                        android:layout_height="@dimen/iconSizeSmall"
                        android:layout_marginEnd="@dimen/spacing_8"
                        android:contentDescription="@string/error"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/colorError" />

                    <TextView
                        android:id="@+id/tvError"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/login_error_default"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                        android:textColor="@color/colorError" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── SIGN IN BUTTON ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                style="@style/Style.DoughlyCrumbl.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/heightButtonPrimary"
                android:layout_marginTop="@dimen/spacing_20"
                android:fontFamily="@font/poppins"
                android:text="@string/login_button"
                android:textAllCaps="false"
                android:textSize="@dimen/textTitleMedium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/errorBanner" />

            <!-- ── LOADING INDICATOR ── -->
            <LinearLayout
                android:id="@+id/loadingContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnLogin">

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="@dimen/iconSizeSmall"
                    android:layout_height="@dimen/iconSizeSmall"
                    android:layout_marginEnd="@dimen/spacing_8"
                    android:indeterminateTint="@color/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="@string/login_signing_in"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/textBodyMedium" />

            </LinearLayout>

            <!-- ── OR DIVIDER ── -->
            <View
                android:id="@+id/dividerLeft"
                android:layout_width="0dp"
                android:layout_height="@dimen/heightDivider"
                android:layout_marginTop="@dimen/spacing_24"
                android:background="@color/colorBorder"
                app:layout_constraintBottom_toBottomOf="@id/tvOr"
                app:layout_constraintEnd_toStartOf="@id/tvOr"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/loadingContainer" />

            <TextView
                android:id="@+id/tvOr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:layout_marginStart="@dimen/spacing_12"
                android:layout_marginEnd="@dimen/spacing_12"
                android:fontFamily="@font/poppins"
                android:text="@string/login_or_continue"
                android:textColor="@color/colorTextMuted"
                android:textSize="@dimen/textCaption"
                app:layout_constraintEnd_toStartOf="@id/dividerRight"
                app:layout_constraintStart_toEndOf="@id/dividerLeft"
                app:layout_constraintTop_toBottomOf="@id/loadingContainer" />

            <View
                android:id="@+id/dividerRight"
                android:layout_width="0dp"
                android:layout_height="@dimen/heightDivider"
                android:background="@color/colorBorder"
                app:layout_constraintBottom_toBottomOf="@id/tvOr"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvOr"
                app:layout_constraintTop_toTopOf="@id/tvOr" />

            <!-- ── GOOGLE BUTTON ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogle"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/heightButtonSecondary"
                android:layout_marginTop="@dimen/spacing_20"
                android:fontFamily="@font/poppins"
                android:text="@string/login_google"
                android:textAllCaps="false"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/textBodyLarge"
                app:backgroundTint="@color/colorSurface"
                app:cornerRadius="@dimen/radiusButton"
                app:icon="@drawable/ic_google"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/spacing_8"
                app:iconSize="@dimen/iconSizeSmall"
                app:iconTint="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvOr"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp" />

            <!-- ── SIGN UP LINK ── -->
            <LinearLayout
                android:id="@+id/signUpRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_28"
                android:gravity="center"
                android:minHeight="@dimen/minTouchTarget"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnGoogle">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_no_account"
                    android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium" />

                <TextView
                    android:id="@+id/tvRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="@string/login_sign_up"
                    android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                    android:textColor="@color/colorPrimary" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
