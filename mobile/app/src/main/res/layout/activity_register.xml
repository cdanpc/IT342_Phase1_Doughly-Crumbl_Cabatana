<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_crimson">

    <!-- Crimson header (~28%) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/scrollCard"
        app:layout_constraintHeight_percent="0.28">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="@dimen/sizeLogoSmall"
            android:layout_height="@dimen/sizeLogoSmall"
            android:padding="@dimen/spacing_4"
            android:src="@drawable/logo_doughly_white"
            android:contentDescription="@string/logo_content_description"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toTopOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0.45" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="@string/register_title"
            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.HeadlineLarge"
            android:textColor="@color/colorSurface"
            app:layout_constraintBottom_toTopOf="@id/tvSubtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivLogo" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:text="@string/register_subtitle"
            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption"
            android:textColor="@color/colorPrimaryLight"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable white card overlapping 16dp -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_card_top_rounded"
        app:layout_constraintTop_toBottomOf="@id/headerSection"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.78">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_24"
            android:paddingEnd="@dimen/spacing_24"
            android:paddingTop="@dimen/spacing_28"
            android:paddingBottom="@dimen/spacing_32">

            <!-- Full Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilName"
                style="@style/Widget.DoughlyCrumbl.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_4"
                android:background="@drawable/bg_input"
                app:boxBackgroundMode="none"
                app:errorEnabled="false"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_nav_profile"
                app:startIconTint="@color/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/heightInput"
                    android:background="@null"
                    android:fontFamily="@font/poppins"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_full_name"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:textSize="@dimen/textBodyLarge" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvNameError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_12"
                android:paddingStart="@dimen/spacing_4"
                android:paddingTop="@dimen/spacing_4"
                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption"
                android:textColor="@color/colorError"
                android:visibility="gone" />

            <!-- Email -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Widget.DoughlyCrumbl.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_4"
                android:background="@drawable/bg_input"
                app:boxBackgroundMode="none"
                app:errorEnabled="false"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="@color/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/heightInput"
                    android:background="@null"
                    android:fontFamily="@font/poppins"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_email_address"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:textSize="@dimen/textBodyLarge" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvEmailError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_12"
                android:paddingStart="@dimen/spacing_4"
                android:paddingTop="@dimen/spacing_4"
                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption"
                android:textColor="@color/colorError"
                android:visibility="gone" />

            <!-- Phone -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPhone"
                style="@style/Widget.DoughlyCrumbl.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_4"
                android:background="@drawable/bg_input"
                app:boxBackgroundMode="none"
                app:errorEnabled="false"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_phone"
                app:startIconTint="@color/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/heightInput"
                    android:background="@null"
                    android:fontFamily="@font/poppins"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_phone"
                    android:imeOptions="actionNext"
                    android:inputType="phone"
                    android:maxLines="1"
                    android:textSize="@dimen/textBodyLarge" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvPhoneError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_12"
                android:paddingStart="@dimen/spacing_4"
                android:paddingTop="@dimen/spacing_4"
                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption"
                android:textColor="@color/colorError"
                android:visibility="gone" />

            <!-- Delivery Address -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAddress"
                style="@style/Widget.DoughlyCrumbl.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_4"
                android:background="@drawable/bg_input"
                app:boxBackgroundMode="none"
                app:errorEnabled="false"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_location"
                app:startIconTint="@color/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/heightInput"
                    android:background="@null"
                    android:fontFamily="@font/poppins"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_delivery_address"
                    android:imeOptions="actionNext"
                    android:inputType="textPostalAddress"
                    android:maxLines="3"
                    android:minLines="1"
                    android:textSize="@dimen/textBodyLarge" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvAddressError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_12"
                android:paddingStart="@dimen/spacing_4"
                android:paddingTop="@dimen/spacing_4"
                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption"
                android:textColor="@color/colorError"
                android:visibility="gone" />

            <!-- Password -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.DoughlyCrumbl.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_4"
                android:background="@drawable/bg_input"
                app:boxBackgroundMode="none"
                app:endIconMode="password_toggle"
                app:errorEnabled="false"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="@color/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/heightInput"
                    android:background="@null"
                    android:fontFamily="@font/poppins"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_password_min"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textSize="@dimen/textBodyLarge" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/spacing_4"
                android:paddingTop="@dimen/spacing_4"
                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption"
                android:textColor="@color/colorError"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/strengthBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dragHandleHeight"
                    android:layout_weight="1"
                    android:background="@drawable/bg_strength_track"
                    android:max="3"
                    android:progress="0"
                    android:progressTint="@color/colorBorder" />

                <TextView
                    android:id="@+id/tvStrengthLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:gravity="end"
                    android:minWidth="48dp"
                    android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption" />

            </LinearLayout>
            <!-- Confirm Password -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmPassword"
                style="@style/Widget.DoughlyCrumbl.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_4"
                android:background="@drawable/bg_input"
                app:boxBackgroundMode="none"
                app:endIconMode="password_toggle"
                app:errorEnabled="false"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="@color/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/heightInput"
                    android:background="@null"
                    android:fontFamily="@font/poppins"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_confirm_password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textSize="@dimen/textBodyLarge" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvConfirmPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                android:paddingStart="@dimen/spacing_4"
                android:paddingTop="@dimen/spacing_4"
                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption"
                android:textColor="@color/colorError"
                android:visibility="gone" />

            <!-- Terms -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_20"
                android:gravity="center"
                android:text="@string/register_terms"
                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.Caption" />

            <!-- Loading indicator -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/spacing_8"
                android:visibility="gone" />

            <!-- Server error banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/errorBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_12"
                android:visibility="gone"
                app:cardBackgroundColor="@color/colorErrorBg"
                app:cardCornerRadius="@dimen/radiusCard"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorError"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_12"
                    android:paddingTop="@dimen/spacing_12"
                    android:paddingEnd="@dimen/spacing_12"
                    android:paddingBottom="@dimen/spacing_12">

                    <ImageView
                        android:layout_width="@dimen/iconSizeSmall"
                        android:layout_height="@dimen/iconSizeSmall"
                        android:layout_marginEnd="@dimen/spacing_8"
                        android:contentDescription="@string/error"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/colorError" />

                    <TextView
                        android:id="@+id/tvError"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                        android:textColor="@color/colorError" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Create Account button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                style="@style/Style.DoughlyCrumbl.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/heightButtonPrimary"
                android:layout_marginBottom="@dimen/spacing_16"
                android:text="@string/register_title"
                android:textAllCaps="false" />

            <!-- Sign In link -->
            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:minHeight="@dimen/minTouchTarget"
                android:padding="@dimen/spacing_8"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="@string/register_sign_in_link"
                android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                android:textColor="@color/colorPrimary" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
