<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorSurface"
        app:navigationIcon="@drawable/ic_back"
        app:title="Payment Instructions"
        app:titleTextAppearance="@style/TextAppearance.DoughlyCrumbl.TitleMedium"
        app:titleTextColor="@color/colorTextPrimary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/marginPage">

            <!-- Intro note -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                app:cardBackgroundColor="@color/colorPrimaryLight"
                app:cardCornerRadius="@dimen/radiusCard"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorPrimary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="How to Pay"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.TitleMedium"
                        android:textColor="@color/colorPrimary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:text="After placing your order, send your payment to any of the accounts below. Then upload your proof of payment in the Order Detail screen."
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                        android:textColor="@color/colorTextPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- GCash -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radiusCard"
                app:cardElevation="@dimen/elevationCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="GCash"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.TitleMedium"
                        android:textColor="@color/colorTextPrimary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/spacing_12"
                        android:background="@color/colorBorder" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Account Name"
                            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                            android:textColor="@color/colorTextSecondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Doughly Crumbl"
                            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                            android:textColor="@color/colorTextPrimary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Number"
                            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                            android:textColor="@color/colorTextSecondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0916 566 7589"
                            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                            android:textColor="@color/colorTextPrimary" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:text="Send the exact order total and include your Order ID in the GCash message field."
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                        android:textColor="@color/colorTextSecondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Maya -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radiusCard"
                app:cardElevation="@dimen/elevationCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Maya (PayMaya)"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.TitleMedium"
                        android:textColor="@color/colorTextPrimary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/spacing_12"
                        android:background="@color/colorBorder" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Account Name"
                            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                            android:textColor="@color/colorTextSecondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Doughly Crumbl"
                            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                            android:textColor="@color/colorTextPrimary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Number"
                            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                            android:textColor="@color/colorTextSecondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0916 566 7589"
                            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                            android:textColor="@color/colorTextPrimary" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:text="Send the exact order total and include your Order ID in the Maya notes/remarks field."
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                        android:textColor="@color/colorTextSecondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bank Transfer -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radiusCard"
                app:cardElevation="@dimen/elevationCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bank Transfer (BDO)"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.TitleMedium"
                        android:textColor="@color/colorTextPrimary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/spacing_12"
                        android:background="@color/colorBorder" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Account Name"
                            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                            android:textColor="@color/colorTextSecondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Doughly Crumbl"
                            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                            android:textColor="@color/colorTextPrimary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Account Number"
                            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                            android:textColor="@color/colorTextSecondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1234 5678 9012"
                            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                            android:textColor="@color/colorTextPrimary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Bank"
                            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                            android:textColor="@color/colorTextSecondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Banco de Oro (BDO)"
                            android:textAppearance="@style/TextAppearance.DoughlyCrumbl.LabelLarge"
                            android:textColor="@color/colorTextPrimary" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:text="Use your Order ID as the transaction reference. Email or message us the deposit slip as proof of payment."
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                        android:textColor="@color/colorTextSecondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- After paying steps -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radiusCard"
                app:cardElevation="@dimen/elevationCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="After Paying"
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.TitleMedium"
                        android:textColor="@color/colorTextPrimary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/spacing_12"
                        android:background="@color/colorBorder" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. Go to Orders and tap your order."
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                        android:textColor="@color/colorTextPrimary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:text="2. Tap Upload Proof of Payment."
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                        android:textColor="@color/colorTextPrimary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:text="3. Attach a clear screenshot or photo of your receipt."
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                        android:textColor="@color/colorTextPrimary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:text="4. We will confirm your payment within 1-2 hours during business hours (8 AM - 8 PM)."
                        android:textAppearance="@style/TextAppearance.DoughlyCrumbl.BodyMedium"
                        android:textColor="@color/colorTextPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
